        "#| fig-cap: Ethane in blanks vs. ambient\n",
        "plot_reference_vs_ambient(\n",
        "    blank_df, ambient_df, \"Ethane\", \"Blank\",\n",
        "    keep_below_threshold=True, figsize=(16, 5),\n",
        ")"
